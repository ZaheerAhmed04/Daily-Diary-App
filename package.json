{
  "name": "daily-diary-android",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android wrapper for the existing Daily Diary app",
  "scripts": {
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:build:debug": "cd android && gradlew.bat assembleDebug",
    "android:build:release": "cd android && gradlew.bat assembleRelease",
    "android:publish-apk": "npm run android:sync && npm run android:build:release && node scripts/copy-release-apk.js",
    "assets:generate-app-qr": "node scripts/generate-app-qr.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "chart.js": "^4.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "qrcode": "^1.5.4"
  }
}
